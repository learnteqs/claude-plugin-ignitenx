[
  {
    "name": "CRLF and lone CR become LF",
    "input": "a\r\nb\rc",
    "normalised": "a\nb\nc"
  },
  {
    "name": "surrounding whitespace is trimmed",
    "input": "  \n hello \t\n",
    "normalised": "hello"
  },
  {
    "name": "tab and newline inside are kept",
    "input": "a\tb\nc",
    "normalised": "a\tb\nc"
  },
  {
    "name": "bidi controls are removed",
    "input": "abc\u202edcba\u202c",
    "normalised": "abcdcba",
    "stripped": {
      "bidi_control": 2
    }
  },
  {
    "name": "bidi isolates and marks are removed",
    "input": "a\u2066b\u2069c\u200ed\u200fe\u061c",
    "normalised": "abcde",
    "stripped": {
      "bidi_control": 5
    }
  },
  {
    "name": "zero-width characters are removed",
    "input": "pa\u200bss\u200dword\ufeff",
    "normalised": "password",
    "stripped": {
      "zero_width": 3
    }
  },
  {
    "name": "soft hyphen and invisible operators are removed",
    "input": "pass\u00adwo\u2062rd",
    "normalised": "password",
    "stripped": {
      "zero_width": 2
    }
  },
  {
    "name": "tag characters (ASCII smuggling) are removed",
    "input": "hi\udb40\udc41\udb40\udc42\udb40\udc7f",
    "normalised": "hi",
    "stripped": {
      "tag_character": 3
    }
  },
  {
    "name": "supplementary variation selectors are removed",
    "input": "x\udb40\udd00y\udb40\uddef",
    "normalised": "xy",
    "stripped": {
      "variation_selector": 2
    }
  },
  {
    "name": "the emoji variation selector is kept",
    "input": "\u2764\ufe0f thanks",
    "normalised": "\u2764\ufe0f thanks"
  },
  {
    "name": "C0, DEL and C1 controls are removed",
    "input": "a\u0000b\u0007c\u007fd\u0085e\u009f",
    "normalised": "abcde",
    "stripped": {
      "control": 5
    }
  },
  {
    "name": "no-break space is kept",
    "input": "a\u00a0b",
    "normalised": "a\u00a0b"
  },
  {
    "name": "Tamil text is unchanged",
